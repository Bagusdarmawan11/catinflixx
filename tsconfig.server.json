{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": ".server-build",
    "target": "ES2020",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["server/**/*.ts", "lib/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "app", "components", ".next"]
}
