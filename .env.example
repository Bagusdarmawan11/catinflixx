# ─── Application ──────────────────────────────────────────────────────────────
# URL aplikasi (tanpa trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment: development | production
NODE_ENV=development

# Port server (default: 3000)
PORT=3000

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Dapatkan dari: https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/catinflix?sslmode=require

# Connection pool URL (untuk Serverless/Edge, optional)
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/catinflix?sslmode=require

# ─── Authentication ────────────────────────────────────────────────────────────
# JWT secret - gunakan string acak minimal 32 karakter
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ─── TMDB API ──────────────────────────────────────────────────────────────────
# Daftar di: https://www.themoviedb.org/settings/api
# Gunakan API Read Access Token (Bearer Token), bukan API Key v3
TMDB_API_TOKEN=eyJhbGciOiJIUzI1NiJ9.YOUR_TOKEN_HERE

# ─── Socket.IO (Watch Party) ───────────────────────────────────────────────────
# URL Socket.IO server (sama dengan APP_URL untuk monorepo)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ─── Optional: Analytics / Monitoring ────────────────────────────────────────
# Isi jika menggunakan layanan monitoring (opsional)
# SENTRY_DSN=
